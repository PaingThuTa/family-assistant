# In production these are Cloudflare Worker secrets. Locally, `npm run setup-telegram` reads .env
# and `npm run dev` reads .dev.vars (same keys).
BOT_TOKEN=
# Telegram user IDs. Send /start to the bot from each phone to see that person's ID.
ADMIN_TELEGRAM_ID=
MOM_TELEGRAM_ID=
DAD_TELEGRAM_ID=
BROTHER_TELEGRAM_ID=
# Turso database (libsql://...) and its token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Public HTTPS address of the Worker (https://family-assistant.<subdomain>.workers.dev).
WEBAPP_URL=
# Random string (letters, digits, _ and - only) that Telegram sends with every update.
WEBHOOK_SECRET=
# Home location for weather and earthquake alerts (rounded to ~1 km before use). Never commit real values.
HOME_LAT=
HOME_LON=
