BOT_TOKEN=
# Telegram user IDs. Send /start to the bot from each phone to see that person's ID.
ADMIN_TELEGRAM_ID=
MOM_TELEGRAM_ID=
DAD_TELEGRAM_ID=
BROTHER_TELEGRAM_ID=
DB_PATH=data/family.db
# Production: a Turso database. When TURSO_DATABASE_URL is set, DB_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Public HTTPS address of this server, for the Mini App (e.g. a cloudflared tunnel URL).
WEBAPP_URL=
PORT=3000
# Home location for weather and earthquake alerts (rounded to ~1 km before use). Never commit real values.
HOME_LAT=
HOME_LON=
